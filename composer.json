{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "icdev/codex-agent-sdk-php",
  "description": "PHP client for OpenAI Codex CLI using codex exec --json",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "ichavezrg",
      "email": "ichavezrg@example.com"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "CodexAgent\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "CodexAgent\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
